# Database (port 5433 to avoid conflict with existing postgres on 5432)
DATABASE_URL=postgresql+asyncpg://trader:trader_dev_123@localhost:5433/stocktrading
DATABASE_URL_SYNC=postgresql://trader:trader_dev_123@localhost:5433/stocktrading

# Redis (port 6380 to avoid conflict with existing redis on 6379)
REDIS_URL=redis://localhost:6380/0

# Fyers API
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=

# Fyers Login Credentials (for auto-login)
FYERS_USERNAME=
FYERS_PIN=
FYERS_TOTP_SECRET=

# Telegram Bot (for outbound alerts from our system)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true  # Set false to disable all Telegram (polling + notifications) when running alongside production

# Telegram User API / MTProto (for reading third-party groups like signal channels)
# Get api_id + api_hash from https://my.telegram.org/apps
# TELEGRAM_PHONE is your account phone in international format, e.g. +919876543210
# TELEGRAM_SESSION_NAME is the local session filename (without .session); stored alongside the script
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=claude_access

# AI Research (Gemini API for multi-agent stock research)
# Vertex AI mode (production on GCE): set GCP_PROJECT_ID to enable.
# Auth via ADC (GCE metadata server) — no API key needed.
# AI Studio mode (local dev): set GOOGLE_API_KEY instead.
GOOGLE_API_KEY=
GCP_PROJECT_ID=
VERTEX_AI_LOCATION=asia-south1
RESEARCH_LLM_PROVIDER=gemini
RESEARCH_LLM_MODEL=gemini-2.5-flash

# Trading Config
TRADING_CAPITAL=1000000
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_RISK_PER_TRADE_PCT=2.0
MAX_TRADES_PER_DAY=3
PAPER_TRADING=true

# App
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000
