# syntax=docker/dockerfile:1
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefix=/install backend/

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl ca-certificates nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Claude Code CLI — the Intraday Hunter agent calls Claude via `claude -p` on the
# CLAUDE_CODE_OAUTH_TOKEN (subscription, not API credits). Installed globally → /usr/local/bin/claude
# (on PATH; shutil.which("claude") in llm_cli.py resolves it). Without the token the agent SKIPs safely.
RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

COPY --from=builder /install /usr/local
COPY backend/ /app/

RUN mkdir -p /app/logs

WORKDIR /app

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--ws-ping-interval", "30", "--ws-ping-timeout", "30"]
