# syntax=docker/dockerfile:1
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/constraints.txt backend/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefix=/install -c backend/constraints.txt backend/

FROM python:3.11-slim

WORKDIR /app

# ffmpeg: Intraday Hunter v2 teacher ingestion (plan keyframes + 5s frame sampling of the live
# recordings; Claude vision reads the chosen frames). yt-dlp comes from pyproject.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl ca-certificates nodejs npm ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Claude Code CLI — the Intraday Hunter agent calls Claude via `claude -p` on the
# CLAUDE_CODE_OAUTH_TOKEN (subscription, not API credits). Installed globally → /usr/local/bin/claude
# (on PATH; shutil.which("claude") in llm_cli.py resolves it). Without the token the agent SKIPs safely.
RUN npm install -g @anthropic-ai/claude-code@2.1.217 && npm cache clean --force

COPY --from=builder /install /usr/local
COPY backend/ /app/

# /app/logs + /app/intraday_hunter_charts are mounted as named volumes in prod
# (see docker-compose.prod.yml) so they survive container recreation on deploy.
RUN mkdir -p /app/logs /app/intraday_hunter_charts

WORKDIR /app

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--ws-ping-interval", "30", "--ws-ping-timeout", "30"]
