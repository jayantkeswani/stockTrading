# Stock Trading — GCP + Terraform environment
# Managed by direnv. Run `direnv allow` after any changes to this file.
# DO NOT commit credentials here — this file is gitignored.

# Activate the stock-trading gcloud named configuration
export CLOUDSDK_ACTIVE_CONFIG_NAME=stock-trading

# Point ADC to the credentials for this specific account
# Stored outside the repo at ~/.gcp/ — never committed to git
export GOOGLE_APPLICATION_CREDENTIALS=$HOME/.gcp/stock-trading-adc.json

# Terraform variables — auto-picked up by terraform as TF_VAR_*
export TF_VAR_project_id=stock-trading-prod
export TF_VAR_github_owner=jayantkeswani
export TF_VAR_github_repo=stockTrading
